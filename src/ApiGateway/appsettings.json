{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-profile-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "auth-notifications-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "auth-admin-users-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/users/{**catch-all}"
        }
      },
      "auth-admin-notifications-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/notifications/{**catch-all}"
        }
      },
      "discovery-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "discovery-partner-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/partner/{**catch-all}"
        }
      },
      "discovery-reviews-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "discovery-favorites-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/favorites/{**catch-all}"
        }
      },
      "social-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/posts/{**catch-all}"
        }
      },
      "social-moods-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/moods/{**catch-all}"
        }
      },
      "social-partner-posts-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/partner/posts/{**catch-all}"
        }
      },
      "social-partner-moods-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/partner/moods/{**catch-all}"
        }
      },
      "social-admin-posts-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/admin/posts/{**catch-all}"
        }
      },
      "social-admin-moods-route": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/api/admin/moods/{**catch-all}"
        }
      },
      "discovery-admin-restaurants-route": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/api/admin/restaurants/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/swagger/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "discovery-swagger": {
        "ClusterId": "discovery-cluster",
        "Match": {
          "Path": "/swagger/discovery/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "social-swagger": {
        "ClusterId": "social-cluster",
        "Match": {
          "Path": "/swagger/social/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "ai-swagger": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/swagger/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:8081"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "discovery-cluster": {
        "Destinations": {
          "discovery-service": {
            "Address": "http://localhost:8082"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "social-cluster": {
        "Destinations": {
          "social-service": {
            "Address": "http://localhost:8083"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai-service": {
            "Address": "http://localhost:8084"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        }
      }
    }
  }
}
