{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "Key": "${JWT_SECRET_KEY}",
    "ExpiryHours": "${JWT_EXPIRY_HOURS}"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "auth-profile-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/profile/{**catch-all}" }
      },
      "auth-notifications-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "discovery-route": {
        "ClusterId": "discovery-cluster",
        "Match": { "Path": "/api/restaurants/{**catch-all}" }
      },
      "social-route": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/api/posts/{**catch-all}" }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },

      
      "auth-swagger": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/swagger/auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "discovery-swagger": {
        "ClusterId": "discovery-cluster",
        "Match": { "Path": "/swagger/discovery/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "social-swagger": {
        "ClusterId": "social-cluster",
        "Match": { "Path": "/swagger/social/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      },
      "ai-swagger": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/swagger/ai/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/swagger/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "auth-service": { "Address": "http://auth-mumi:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "discovery-cluster": {
        "Destinations": { "discovery-service": { "Address": "http://generous-education:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "social-cluster": {
        "Destinations": { "social-service": { "Address": "http://reliable-manifestation:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      },
      "ai-cluster": {
        "Destinations": { "ai-service": { "Address": "http://earnest-consideration:8080" } },
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:30", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" } }
      }
    }
  }
}
